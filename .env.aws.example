# ================================================================
# FILE NÀY CHỈ LÀ VÍ DỤ — KHÔNG COMMIT LÊN GIT
# Khi deploy AWS: các giá trị này được lưu trong AWS Secrets Manager
# và inject vào ECS Task Definition qua "valueFrom"
# ================================================================

# ── Backend Environment Variables (ECS Task Definition) ─────────

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Lấy từ AWS Secrets Manager (arn:aws:secretsmanager:...)
ConnectionStrings__DefaultConnection=Server=<RDS_ENDPOINT>,1433;Database=SportFieldBookingDb;User Id=sportbookingadmin;Password=<SECRET>;TrustServerCertificate=True;

# Lấy từ AWS ElastiCache endpoint
Redis__ConnectionString=<ELASTICACHE_ENDPOINT>:6379

# JWT — lấy từ Secrets Manager
Jwt__SecretKey=<STRONG_RANDOM_SECRET_MIN_32_CHARS>
Jwt__Issuer=https://yourdomain.com
Jwt__Audience=https://yourdomain.com

# CORS — URL thực của CloudFront/domain
FrontendUrl=https://yourdomain.com
ApiUrl=https://api.yourdomain.com

# Email (nếu có cấu hình SES)
# EmailSettings__SmtpHost=email-smtp.ap-southeast-1.amazonaws.com
# EmailSettings__From=noreply@yourdomain.com

# ── Frontend Build Args (CI/CD pipeline) ────────────────────────
# Truyền khi build Docker image cho frontend
VITE_API_BASE_URL=https://api.yourdomain.com/api
